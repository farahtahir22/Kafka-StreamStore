# Copy this file to .env and fill in real values.
#
# Right now these point at the local MinIO container (docker-compose's
# `minio` service) - MinIO uses AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY as
# its root username/password, so the same two vars double as both the
# MinIO login and the S3-compatible credentials pyiceberg uses.
#
# When you have a real AWS account: point S3_ENDPOINT at your bucket's
# region (or drop it entirely - pyiceberg defaults to AWS's real S3
# endpoints when none is set) and put real AWS keys in AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY. No code changes needed - catalog.py just reads
# these same variable names.

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT=http://localhost:9002
